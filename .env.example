
# CareerForge PostgreSQL configuration
# These settings are for Python scripts running on your Windows host.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=careerforge
POSTGRES_USER=careerforge_app
POSTGRES_PASSWORD=replace_with_a_local_password

# Optional strategy engine configuration
CAREERFORGE_PROFILE_ID=
CAREERFORGE_LOG_LEVEL=INFO
POSTGRES_CONNECT_TIMEOUT=8
